      "id": "G13",
      "bts": "S15",
      "level": "L3",
      "ci_block": true,
      "task": "A departed employee still has access — SCIM drift.",
      "handler": "access-review",
      "args": { "scope": "agents", "scim": true },
      "required_phrases": ["reconciliation", "deprovisioning", "timestamp", "badge", "ghost"],
      "forbidden_phrases": ["fix the SCIM pipe", "stamp fixes the webhook"]
