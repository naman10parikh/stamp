{
  "dsip": "0.1",
  "product": "stamp",
  "levels": ["agent"],
  "loop": {
    "cadence": "nightly",
    "steps": ["refresh-brain", "re-verify-tool-matrix", "run-eval-pyramid", "propose", "validate", "ship"]
  },
  "selection": "performance-novelty",
  "eval": {
    "rubric": "eval/grade.ts",
    "gate": "acceptance-test-green && no-regression",
    "noSelfGrading": true
  },
  "snapback": { "granularity": ["skill", "employee"], "vcs": "git" },
  "externalIntelligence": { "enabled": true, "source": "vertical ecosystem watch (changelogs, issues, X) per brain/TOOL-MATRIX.md" }
}
