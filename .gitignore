# wikimem
.wikimem-cache/
node_modules/

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Build output (regenerated by `pnpm build`; shipped via package.json "files" on publish).
# NOTE: logs/runs.jsonl is deliberately NOT ignored — E3's run-trail must stay visible
# (DONE-criteria row 10). Only the build artifact is ignored here.
dist/

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

# Playwright cockpit-E2E artifacts (regenerated each run; the spec is the source of truth)
test-results/
playwright-report/
.playwright/

.env
